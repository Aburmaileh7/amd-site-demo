---
import Img from './Img.astro';
const { p } = Astro.props;
const a = p.amenities;
const img = a?.image ? p.images[a.image] : null;
const icons = {
  sky: '<path d="M3 17h18M5 17V9l7-4 7 4v8"/><path d="M9 17v-4h6v4"/>',
  calendar: '<rect x="3.5" y="5" width="17" height="15" rx="2"/><path d="M3.5 10h17M8 3v4M16 3v4"/>',
  bag: '<path d="M5 8h14l-1 12H6L5 8z"/><path d="M9 8V6a3 3 0 0 1 6 0v2"/>',
  car: '<path d="M4 16v-4l2-5h12l2 5v4"/><path d="M3 16h18v2H3z"/><circle cx="7.5" cy="13" r="1"/><circle cx="16.5" cy="13" r="1"/>',
  check: '<path d="M5 12.5l4.5 4.5L19 7.5"/>',
  wifi: '<path d="M3 9a14 14 0 0 1 18 0M6 12.5a9 9 0 0 1 12 0M9 16a4 4 0 0 1 6 0"/><circle cx="12" cy="19" r="1"/>',
  tree: '<path d="M12 21v-5M7 16h10l-5-12-5 12z"/>',
  family: '<circle cx="8" cy="7" r="2.5"/><circle cx="16" cy="7" r="2.5"/><path d="M4 20v-5a4 4 0 0 1 8 0v5M12 20v-5a4 4 0 0 1 8 0v5"/>',
  clock: '<circle cx="12" cy="12" r="8.5"/><path d="M12 7.5V12l3 2"/>',
  tooth: '<path d="M8 3.5c-3 0-4.5 2.5-4 5.5.4 2.6 1.5 4 2 7 .4 2.5 1.2 4.5 2.5 4.5 1.6 0 1.5-4 3.5-4s1.9 4 3.5 4c1.3 0 2.1-2 2.5-4.5.5-3 1.6-4.4 2-7 .5-3-1-5.5-4-5.5-1.7 0-2.6 1-4 1s-2.3-1-4-1z"/>',
  shield: '<path d="M12 3l7 3v5c0 4.5-3 8.2-7 10-4-1.8-7-5.5-7-10V6l7-3z"/><path d="M9 12l2 2 4-4"/>',
  coffee: '<path d="M4 9h13v5a5 5 0 0 1-5 5H9a5 5 0 0 1-5-5V9z"/><path d="M17 10h1.5a2.5 2.5 0 0 1 0 5H17M8 3v3M12 3v3"/>',
  access: '<circle cx="12" cy="4.5" r="1.8"/><path d="M12 7v6h5l2 6"/><path d="M8.5 11a5.5 5.5 0 1 0 6.9 7.6"/>'
};
---
{a && a.items?.length > 0 && (
<section class={`amen ${img ? '' : 'amen--noimg'}`} aria-labelledby="amen-title">
  <div class="wrap amen__grid">
    {img && (
      <div class="amen__media" data-parallax="-8">
        <Img img={img} sizes="(min-width: 900px) 42vw, 100vw" />
      </div>
    )}
    <div class="amen__body">
      {a.eyebrow && <p class="eyebrow" data-reveal>{a.eyebrow}</p>}
      <h2 id="amen-title" class="amen__title" data-reveal>{a.title}</h2>
      <ul class="amen__list">
        {a.items.map((it) => (
          <li data-reveal>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={icons[it.icon] || icons.check}></svg>
            <div><h3>{it.title}</h3>{it.text && <p class="muted">{it.text}</p>}</div>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>
)}

<style>
  .amen { padding-block: clamp(80px, 12vw, 150px); background: var(--surface); }
  .amen__grid { display: grid; gap: 48px; }
  @media (min-width: 900px) { .amen__grid { grid-template-columns: 1fr 1.1fr; gap: 80px; align-items: center; } }
  .amen__media :global(.photo) { aspect-ratio: 4 / 5; border-radius: var(--radius); }
  .amen--noimg .amen__grid { grid-template-columns: 1fr; max-width: 820px; }
  .amen__body { display: grid; gap: 14px; }
  .amen__title { font-size: clamp(2rem, 5vw, 3.4rem); font-weight: var(--display-weight); margin-bottom: 18px; }
  .amen__list { list-style: none; margin: 0; padding: 0; }
  .amen__list li { display: grid; grid-template-columns: 28px 1fr; gap: 18px; padding: 20px 0; border-top: 1px solid var(--line); }
  .amen__list li:last-child { border-bottom: 1px solid var(--line); }
  .amen__list svg { width: 26px; height: 26px; color: var(--glow); margin-top: 4px; }
  .amen__list h3 { font-size: 1.15rem; font-weight: 500; margin-bottom: 2px; }
</style>
