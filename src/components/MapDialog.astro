---
const { p } = Astro.props;
const src = p.map_query ? `https://maps.google.com/maps?q=${encodeURIComponent(p.map_query)}&z=16&hl=ar&output=embed` : null;
---
{src && (<dialog class="mapd" data-map-dialog aria-labelledby="mapd-title">
  <div class="mapd__box" data-map-box>
    <div class="mapd__bar">
      <p id="mapd-title" class="mapd__title">{p.name} · {p.area}</p>
      <div class="mapd__actions">
        {p.directions_url && <a class="mapd__open" href={p.directions_url} target="_blank" rel="noopener">افتح في Google Maps</a>}
        <button class="mapd__close" type="button" data-map-close aria-label="إغلاق الخريطة">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"/></svg>
        </button>
      </div>
    </div>
    <div class="mapd__frame">
      <iframe title={`خريطة ${p.name}`} data-src={src} loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>
    </div>
  </div>
</dialog>)}

<style>
  .mapd { border: 0; padding: 0; background: transparent; width: min(100% - 24px, 1100px); max-width: none; max-height: none; color: var(--ink); }
  .mapd::backdrop { background: rgba(5,5,7,.78); }
  .mapd__box { background: var(--surface); border: 1px solid var(--line); border-radius: 16px; overflow: hidden; box-shadow: 0 30px 80px rgba(0,0,0,.5); }
  .mapd__bar { display: flex; align-items: center; justify-content: space-between; gap: 12px; padding: 12px 16px; border-bottom: 1px solid var(--line); flex-wrap: wrap; }
  .mapd__title { font-family: var(--font-d); font-weight: 500; }
  .mapd__actions { display: flex; align-items: center; gap: 10px; }
  .mapd__open { color: var(--glow); font-size: .9rem; }
  .mapd__close { width: 44px; height: 44px; border-radius: 50%; border: 1px solid var(--line); background: none; color: var(--ink); cursor: pointer; display: grid; place-items: center; }
  .mapd__close svg { width: 20px; height: 20px; }
  .mapd__frame { height: min(70vh, 620px); background: var(--surface-2); }
  .mapd__frame iframe { width: 100%; height: 100%; border: 0; display: block; filter: grayscale(.2) contrast(1.05); }
</style>
