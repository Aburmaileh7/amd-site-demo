---
import Img from './Img.astro';
const { p } = Astro.props;
const variant = p.layout.hero;            // "full" | "split"
const img = p.hero.image ? p.images[p.hero.image] : null;
const fmt = (n) => n.toLocaleString('en-US');
const primary = p.directions_url
  ? { href: p.directions_url, label: p.cta_label || 'الاتجاهات على الخريطة', ext: true }
  : p.phone ? { href: `tel:${p.phone.tel}`, label: 'اتصل الآن', ext: false } : null;
---
<section class={`hero hero--${variant} ${img ? '' : 'hero--noimg'}`} aria-label={p.name}>
  {variant === 'full' && img && (
    <>
      <div class="hero__media" data-hero-media><Img img={img} eager pos="50% 60%" /></div>
      <div class="hero__shade" aria-hidden="true"></div>
    </>
  )}

  <div class="wrap hero__grid">
    <div class="hero__content">
      <p class="eyebrow" data-hero-in>{p.category_label} · {p.area}</p>
      <h1 class={`hero__title ${p.name.length > 16 ? 'hero__title--long' : ''}`} lang={p.name_lang || 'ar'}><span data-line><span>{p.name}</span></span></h1>
      <p class="hero__headline" data-hero-in>{p.hero.headline}</p>
      {p.hero.intro && <p class="hero__intro muted" data-hero-in>{p.hero.intro}</p>}

      <div class="hero__actions" data-hero-in>
        {primary && (
          <a class="btn btn--glow" href={primary.href} target={primary.ext ? '_blank' : undefined} rel={primary.ext ? 'noopener' : undefined}>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M12 21s-7-6.2-7-11.5A7 7 0 0 1 19 9.5C19 14.8 12 21 12 21z"/><circle cx="12" cy="9.5" r="2.5"/></svg>
            {primary.label}
          </a>
        )}
        {p.phone && primary && primary.ext && (
          <a class="btn btn--ghost" href={`tel:${p.phone.tel}`}>اتصل · <span class="ltr">{p.phone.display}</span></a>
        )}
      </div>

      {p.rating && (
        <p class="hero__rating" data-hero-in>
          <span class="star" aria-hidden="true"></span>
          <strong>{p.rating.value.toFixed(1)}</strong>
          <span class="muted">من 5 · {fmt(p.rating.count)} تقييمًا على {p.rating.source}</span>
        </p>
      )}
    </div>

    {variant === 'split' && img && (
      <div class="hero__side" data-hero-side>
        <Img img={img} eager sizes="(min-width: 900px) 45vw, 100vw" />
      </div>
    )}
  </div>

  {variant === 'full' && <div class="hero__cue" aria-hidden="true"><span></span></div>}
</section>

<style>
  .hero { position: relative; isolation: isolate; overflow: hidden; }
  .hero__title { font-size: clamp(3rem, 12vw, 8.5rem); font-weight: var(--display-weight); letter-spacing: -.03em; line-height: 1; font-family: var(--font-d); }
  .hero__headline { font-family: var(--font-ui); font-size: clamp(1.25rem, 3.4vw, 1.9rem); font-weight: 500; max-width: 22em; text-wrap: balance; }
  .hero__intro { max-width: 34em; font-size: 1.05rem; }
  .hero__content { display: grid; gap: 18px; align-content: end; }
  .hero__actions { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 10px; }
  .hero__rating { display: flex; align-items: center; gap: .5rem; flex-wrap: wrap; font-size: .95rem; }
  .hero__rating strong { font-family: var(--font-ui); font-size: 1.15rem; font-weight: 500; }
  .star { width: 15px; height: 15px; background: var(--glow);
    clip-path: polygon(50% 0,61% 35%,98% 35%,68% 57%,79% 91%,50% 70%,21% 91%,32% 57%,2% 35%,39% 35%); }

  /* full-bleed */
  .hero--full { min-height: 100svh; display: flex; align-items: flex-end; }
  .hero--full .hero__grid { padding-block: 150px clamp(72px, 12vh, 120px); width: min(100% - 2 * var(--gutter), var(--maxw)); }
  .hero__media { position: absolute; inset: -6% 0 0; z-index: -2; will-change: transform; }
  .hero__media :global(.photo) { height: 100%; }
  .hero__media :global(.photo__badge) { bottom: auto; top: 136px; }
  .hero__shade { position: absolute; inset: 0; z-index: -1;
    background: linear-gradient(to top, var(--bg) 2%, rgba(var(--bg-rgb), .86) 32%, rgba(var(--bg-rgb), .35) 62%, rgba(var(--bg-rgb), .55) 100%),
                radial-gradient(60% 50% at 80% 100%, rgba(var(--glow-rgb), .16), transparent 70%); }
  .hero__cue { position: absolute; inset-inline-start: var(--gutter); bottom: 28px; width: 1px; height: 56px; background: var(--line); overflow: hidden; }
  .hero__cue span { display: block; width: 100%; height: 40%; background: var(--glow); animation: cue 2.2s var(--ease) 3; }
  @keyframes cue { from { transform: translateY(-100%); } to { transform: translateY(260%); } }
  @media (max-width: 700px) { .hero__cue { display: none; } }

  /* split: text + framed photo */
  .hero--split { padding-block: clamp(140px, 18vh, 190px) clamp(64px, 10vw, 120px); }
  .hero--split .hero__grid { display: grid; gap: 40px; align-items: center; }
  @media (min-width: 900px) { .hero--split .hero__grid { grid-template-columns: 1.05fr 1fr; gap: 64px; } }
  .hero--split .hero__title { font-size: clamp(2.8rem, 9vw, 6.2rem); }
  .hero__title--long, .hero--split .hero__title--long { font-size: clamp(2.4rem, 7vw, 4.6rem); line-height: 1.05; }
  .hero__side { border-radius: var(--radius); overflow: hidden; }
  .hero__side :global(.photo) { aspect-ratio: 4 / 5; }
  @media (max-width: 899px) { .hero__side :global(.photo) { aspect-ratio: 4 / 3; } }
  .hero--noimg.hero--split .hero__grid { grid-template-columns: 1fr; max-width: 900px; }

  @media (prefers-reduced-motion: reduce) { .hero__cue span { animation: none; } }
</style>
