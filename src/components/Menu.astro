---
import Img from './Img.astro';
const { p } = Astro.props;
const m = p.menu;
const priced = m && m.kind !== 'services';
const price = (n) => Number(n).toFixed(2);
---
{m && m.categories?.length > 0 && (
<section class={`menu ${priced ? '' : 'menu--services'}`} id="menu" aria-labelledby="menu-title">
  <div class="wrap">
    <div class="menu__head">
      <div>
        {m.eyebrow && <p class="eyebrow" data-reveal>{m.eyebrow}</p>}
        <h2 id="menu-title" class="menu__title"><span data-line><span>{m.title || 'المنيو'}</span></span></h2>
      </div>
      {m.note && <p class="menu__sample" data-reveal><span class="dot" aria-hidden="true"></span>{m.note}</p>}
    </div>

    <div class={`tabs ${m.categories.length < 2 ? 'tabs--single' : ''}`} role="tablist" aria-label="أقسام المنيو" data-menu-tabs data-reveal>
      {m.categories.map((c, i) => (
        <button role="tab" id={`tab-${c.id}`} aria-controls={`panel-${c.id}`} aria-selected={i === 0 ? 'true' : 'false'}
                tabindex={i === 0 ? '0' : '-1'} data-tab={c.id}>
          {c.title}<span class="tabs__count">{c.items.length}</span>
        </button>
      ))}
      <span class="tabs__ink" aria-hidden="true" data-tabs-ink></span>
    </div>

    <div class="panels" data-menu-panels>
      {m.categories.map((c, i) => (
        <div class="panel-m" role="tabpanel" id={`panel-${c.id}`} aria-labelledby={`tab-${c.id}`} data-panel-id={c.id} data-active={i === 0 ? 'true' : 'false'}>
          <div class="panel-m__visual">
            {c.image && p.images[c.image] ? <Img img={p.images[c.image]} sizes="(min-width: 900px) 40vw, 100vw" /> : <div class="panel-m__plain" aria-hidden="true"></div>}
            <div class="panel-m__caption">
              <p class="panel-m__tag">{c.tagline}</p>
              <p class="panel-m__name">{c.title}</p>
            </div>
          </div>

          <ul class="items" data-spot>
            {c.items.map((it) => (
              <li class="item" data-item>
                <div class="item__row">
                  <h3 class="item__name">{it.name}</h3>
                  {priced && it.price != null && <span class="item__lead" aria-hidden="true"></span>}
                  {priced && it.price != null && <p class="item__price"><span class="ltr">{price(it.price)}</span> <span class="cur">{m.currency}</span></p>}
                </div>
                {it.desc && <p class="item__desc muted">{it.desc}</p>}
                {it.mentioned && <p class="item__badge">ورد في مراجعات الزوار</p>}
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>

    {p.phone && (
      <div class="menu__foot" data-reveal>
        <p class="muted">{m.foot || 'للاستفسار'}</p>
        <a class="btn btn--ghost" href={`tel:${p.phone.tel}`}>اتصل · <span class="ltr">{p.phone.display}</span></a>
      </div>
    )}
  </div>
</section>
)}

<style>
  .menu { padding-block: clamp(90px, 13vw, 160px); background:
    radial-gradient(70% 50% at 100% 0%, rgba(var(--glow-rgb), .07), transparent 60%), var(--bg); border-top: 1px solid var(--line); }
  .menu__head { display: grid; gap: 20px; margin-bottom: 40px; }
  @media (min-width: 900px) { .menu__head { grid-template-columns: 1fr 380px; align-items: end; } }
  .menu__title { font-size: clamp(3.4rem, 12vw, 8rem); font-weight: var(--display-weight); letter-spacing: -.03em; line-height: 1; }
  .menu__sample { font-size: .85rem; line-height: 1.7; color: var(--muted); border: 1px dashed rgba(var(--glow-rgb), .45); border-radius: 10px; padding: 12px 14px; display: flex; gap: 10px; }
  .dot { flex: none; width: 8px; height: 8px; border-radius: 50%; background: var(--glow); margin-top: 8px; }

  /* tabs */
  .tabs { position: relative; display: flex; gap: 4px; overflow-x: auto; scrollbar-width: none; border-bottom: 1px solid var(--line); margin-bottom: clamp(28px, 4vw, 48px); }
  .tabs::-webkit-scrollbar { display: none; }
  .tabs--single { display: none; }
  .tabs button { flex: none; background: none; border: 0; color: var(--muted); font-family: var(--font-ui); font-size: clamp(1rem, 2.4vw, 1.25rem); padding: 14px 18px 18px; cursor: pointer; display: inline-flex; gap: 8px; align-items: baseline; transition: color .3s; }
  .tabs button:hover { color: var(--ink); }
  .tabs button[aria-selected="true"] { color: var(--ink); }
  .tabs__count { font-size: .7rem; color: var(--glow); }
  .tabs__ink { position: absolute; bottom: -1px; height: 2px; background: var(--glow); box-shadow: 0 0 18px rgba(var(--glow-rgb), .7); width: 0; left: 0; }

  /* panels: without JS every category is shown */
  .panel-m { display: grid; gap: 28px; margin-bottom: 64px; }
  :global(.js) .panel-m[data-active="false"] { display: none; }
  :global(.js) .panel-m { margin-bottom: 0; }
  @media (min-width: 900px) { .panel-m { grid-template-columns: 1fr 1.25fr; gap: 64px; align-items: start; } }

  .panel-m__visual { position: relative; border-radius: var(--radius); overflow: hidden; }
  @media (min-width: 900px) { .panel-m__visual { position: sticky; top: 100px; } }
  .panel-m__visual :global(.photo), .panel-m__plain { aspect-ratio: 4 / 5; }
  .panel-m__plain { background: radial-gradient(80% 60% at 30% 20%, rgba(var(--glow-rgb), .25), transparent 70%), var(--surface-2); }
  @media (max-width: 899px) { .panel-m__visual :global(.photo), .panel-m__plain { aspect-ratio: 16 / 10; } }
  .menu--services .panel-m__visual { display: none; }
  .menu--services .panel-m { grid-template-columns: 1fr; }
  @media (min-width: 900px) { .menu--services .items { display: grid; grid-template-columns: 1fr 1fr; column-gap: 48px; } .menu--services .item:nth-child(2) { border-top: 1px solid var(--line); } }
  .panel-m__visual::after { content: ""; position: absolute; inset: 0; background: linear-gradient(to top, rgba(var(--bg-rgb), .85), transparent 55%); pointer-events: none; }
  .panel-m__visual :global(.photo__badge) { bottom: auto; top: 12px; }
  .panel-m__caption { position: absolute; inset-inline: 22px; bottom: 20px; z-index: 2; }
  .panel-m__tag { color: var(--glow); font-size: .85rem; font-family: var(--font-ui); }
  .panel-m__name { font-family: var(--font-d); font-size: clamp(2rem, 5vw, 3.2rem); font-weight: var(--display-weight); line-height: 1.1; }

  /* items with a light that follows the pointer */
  .items { list-style: none; margin: 0; padding: 0; position: relative; --mx: 50%; --my: -200px; }
  .items::before { content: ""; position: absolute; inset: 0; pointer-events: none; border-radius: 12px;
    background: radial-gradient(260px circle at var(--mx) var(--my), rgba(var(--glow-rgb), .09), transparent 70%); }
  .item { position: relative; padding: 22px 6px; border-bottom: 1px solid var(--line); transition: transform .4s var(--ease); }
  .item:first-child { border-top: 1px solid var(--line); }
  @media (hover: hover) { .item:hover { transform: translateX(-6px); } .item:hover .item__price { color: var(--glow); } .item:hover .item__lead { border-color: rgba(var(--glow-rgb), .5); } }
  .item__row { display: flex; align-items: baseline; gap: 14px; }
  .item__name { font-size: clamp(1.15rem, 2.6vw, 1.45rem); font-weight: 500; }
  .item__lead { flex: 1; border-bottom: 1px dotted rgba(var(--ink-rgb), .25); transform: translateY(-6px); min-width: 24px; transition: border-color .3s; }
  .item__price { font-family: var(--font-ui); font-size: 1.15rem; white-space: nowrap; transition: color .3s; }
  .cur { font-size: .8rem; color: var(--muted); }
  .item__desc { font-size: .95rem; margin-top: 4px; max-width: 34em; }
  .item__badge { display: inline-block; margin-top: 10px; font-size: .75rem; color: var(--glow); border: 1px solid rgba(var(--glow-rgb), .4); border-radius: 999px; padding: 2px 10px; }

  .menu__foot { margin-top: 56px; display: flex; flex-wrap: wrap; gap: 16px; align-items: center; justify-content: space-between; border-top: 1px solid var(--line); padding-top: 28px; }
</style>
